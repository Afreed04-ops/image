    "# Final robust detector: multi-scale, rotation-aware, NMS, annotated output\n",
    "import fitz         # PyMuPDF\n",
    "import cv2\n",
    "import numpy as np\n",
    "import os\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "# ---------- USER CONFIG ----------\n",
    "pdf_path = r\"D:/Bahjoi_SIP.pdf\"\n",
    "ref_paths = [r\"D:/l5.jpg\"]   # your two reference images\n",
    "output_dir = r\"/mnt/data/pdf_matches\"\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "dpi = 300                       # render DPI (increase to 400-600 for tiny templates)\n",
    "scales = np.linspace(0.6, 1.4, 9)   # try 0.4..2.0 if shapes vary a lot\n",
    "angles = [0, 90, 180, 270]      # rotations to test (add intermediate angles if needed)\n",
    "threshold = 0.60                # template-matching threshold (lower to be more permissive)\n",
    "nms_iou_thresh = 0.35           # IoU threshold for non-maximum suppression\n",
    "max_peaks_per_scale = 8         # limit peaks per scale to speed up processing\n",
    "# ---------------------------------\n",
    "\n",
    "# load pdf page(s)\n",
    "doc = fitz.open(pdf_path)\n",
    "num_pages = len(doc)\n",
    "print(f\"✅ PDF loaded: {pdf_path} ({num_pages} pages)\")\n",
    "\n",
    "# We'll process each page and accumulate counts\n",
    "total_counts = [0] * len(ref_paths)\n",
    "annotated_pages = []\n",
    "\n",
    "for page_idx in range(num_pages):\n",
    "    page = doc.load_page(page_idx)\n",
    "    pix = page.get_pixmap(dpi=dpi)\n",
    "    img_data = np.frombuffer(pix.tobytes(\"png\"), np.uint8)\n",
    "    page_bgr = cv2.imdecode(img_data, cv2.IMREAD_COLOR)\n",
    "    page_gray = cv2.cvtColor(page_bgr, cv2.COLOR_BGR2GRAY)\n",
    "\n",
    "    print(f\"\\n🔍 Scanning page {page_idx+1}/{num_pages} (render: {pix.width}x{pix.height} px)\")\n",
    "\n",
    "    # To draw boxes for preview\n",
    "    annotated = page_bgr.copy()\n",
    "\n",
    "    for ref_idx, ref_path in enumerate(ref_paths):\n",
    "        ref_orig = cv2.imread(ref_path, cv2.IMREAD_GRAYSCALE)\n",
    "        if ref_orig is None:\n",
    "            raise FileNotFoundError(f\"Reference image not found: {ref_path}\")\n",
    "\n",
    "        # optional binarization helps for simple black-line drawings:\n",
    "        _, ref_bin = cv2.threshold(ref_orig, 200, 255, cv2.THRESH_BINARY)\n",
    "\n",
    "        detections = []  # list of (x,y,w,h,score)\n",
    "\n",
    "        for angle in angles:\n",
    "            # rotate template\n",
    "            if angle != 0:\n",
    "                # rotate keeping same size canvas\n",
    "                (h0, w0) = ref_bin.shape\n",
    "                M = cv2.getRotationMatrix2D((w0 / 2, h0 / 2), angle, 1.0)\n",
    "                rotated = cv2.warpAffine(ref_bin, M, (w0, h0), borderValue=255)\n",
    "            else:\n",
    "                rotated = ref_bin\n",
    "\n",
    "            for scale in scales:\n",
    "                tw = max(2, int(rotated.shape[1] * scale))\n",
    "                th = max(2, int(rotated.shape[0] * scale))\n",
    "                if tw >= page_gray.shape[1] or th >= page_gray.shape[0]:\n",
    "                    continue\n",
    "\n",
    "                template = cv2.resize(rotated, (tw, th), interpolation=cv2.INTER_AREA if scale < 1 else cv2.INTER_LINEAR)\n",
    "\n",
    "                # run template match\n",
    "                res = cv2.matchTemplate(page_gray, template, cv2.TM_CCOEFF_NORMED)\n",
    "\n",
    "                # get coordinates of peaks above threshold\n",
    "                loc = np.where(res >= threshold)\n",
    "                # gather (score, (x,y))\n",
    "                peaks = []\n",
    "                for (x, y) in zip(*loc[::-1]):\n",
    "                    peaks.append((res[y, x], x, y))\n",
    "                # sort peaks by score descending and keep top K to avoid flooding\n",
    "                peaks = sorted(peaks, key=lambda p: -p[0])[:max_peaks_per_scale]\n",
    "\n",
    "                for score, x, y in peaks:\n",
    "                    detections.append((int(x), int(y), int(tw), int(th), float(score)))\n",
    "\n",
    "        # Non-maximum suppression (greedy by score)\n",
    "        detections = sorted(detections, key=lambda d: -d[4])\n",
    "        kept = []\n",
    "        for det in detections:\n",
    "            x, y, w, h, sc = det\n",
    "            box = np.array([x, y, x + w, y + h])\n",
    "            suppress = False\n",
    "            for k in kept:\n",
    "                kx, ky, kw, kh, ksc = k\n",
    "                kbox = np.array([kx, ky, kx + kw, ky + kh])\n",
    "                # compute IoU\n",
    "                ix1 = max(box[0], kbox[0]); iy1 = max(box[1], kbox[1])\n",
    "                ix2 = min(box[2], kbox[2]); iy2 = min(box[3], kbox[3])\n",
    "                iw = max(0, ix2 - ix1); ih = max(0, iy2 - iy1)\n",
    "                inter = iw * ih\n",
    "                area = (box[2] - box[0]) * (box[3] - box[1])\n",
    "                area_k = (kbox[2] - kbox[0]) * (kbox[3] - kbox[1])\n",
    "                union = area + area_k - inter\n",
    "                iou = inter / union if union > 0 else 0\n",
    "                if iou > nms_iou_thresh:\n",
    "                    suppress = True\n",
    "                    break\n",
    "            if not suppress:\n",
    "                kept.append(det)\n",
    "\n",
    "        # record detections, draw boxes\n",
    "        print(f\"  • {os.path.basename(ref_path)} -> raw detections: {len(detections)}, distinct after NMS: {len(kept)}\")\n",
    "        total_counts[ref_idx] += len(kept)\n",
    "        for (x, y, w, h, sc) in kept:\n",
    "            cv2.rectangle(annotated, (x, y), (x + w, y + h), (0, 0, 255), 2)\n",
    "            # label with score\n",
    "            cv2.putText(annotated, f\"{sc:.2f}\", (x, y - 4), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,0,255), 1)\n",
    "\n",
    "    # save annotated preview for this page\n",
    "    out_img = os.path.join(output_dir, f\"page_{page_idx+1}_annotated.png\")\n",
    "    cv2.imwrite(out_img, annotated)\n",
    "    annotated_pages.append(out_img)\n",
    "    print(f\"  → Annotated preview saved: {out_img}\")\n",
    "\n",
    "doc.close()\n",
    "\n",
    "# Final summary\n",
    "total = sum(total_counts)\n",
    "print(\"\\n🎯 Final counts:\")\n",
    "for i, c in enumerate(total_counts):\n",
    "    print(f\"  {os.path.basename(ref_paths[i])}: {c} matches\")\n",
    "print(f\"  TOTAL (sum): {total}\")\n",
    "\n",
    "# Show annotated previews inline (if running in Jupyter)\n",
    "try:\n",
    "    from IPython.display import display, Image as IPImage\n",
    "    for p in annotated_pages:\n",
    "        display(IPImage(filename=p))\n",
    "except Exception:\n",
    "        pass\n"
   ]
